# Talking-avatar provider: heygen | did | replicate | local | auto
AI_VIDEO_PROVIDER=auto

# Shared key (used when a provider-specific key is not set)
AI_VIDEO_API_KEY=

# Provider-specific keys (never commit real values)
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
HEYGEN_ENGINE=avatar_iv

DID_API_KEY=
DID_API_SECRET=

REPLICATE_API_TOKEN=
REPLICATE_MODEL=cjwbw/sadtalker

# Text-to-speech: edge | elevenlabs | azure | provider
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Microsoft Edge neural voice (UK English, no API key required)
EDGE_TTS_VOICE=en-GB-SoniaNeural
EDGE_TTS_RATE=-10%

# Output
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
AUDIO_SAMPLE_RATE=48000

# Preview uses a short excerpt of the transcript
PREVIEW_SECONDS=12
